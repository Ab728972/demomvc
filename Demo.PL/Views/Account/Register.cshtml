@model RegisterViewModel
@{
    ViewData["Title"] = "Register"; Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<h2 class="text-center">Register</h2>
<form asp-action="Register">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="row">
        <div class="col-6">
            <input asp-for="FName" class="form-control" placeholder="First Name" />
            <span asp-validation-for="FName" class="text-danger"></span>
        </div>
        <div class="col-6">
            <input asp-for="LName" class="form-control" placeholder="Last Name" />
            <span asp-validation-for="LName" class="text-danger"></span>
        </div>
    </div>
    <br />
    <input asp-for="Email" class="form-control" placeholder="Email" />
    <span asp-validation-for="Email" class="text-danger"></span>
    <br />
    <input asp-for="Password" class="form-control" placeholder="Password" />
    <span asp-validation-for="Password" class="text-danger"></span>
    <br />
    <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm Password" />
    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    <br />
    <div class="form-check">
        <input asp-for="IsAgree" class="form-check-input" />
        <label class="form-check-label">I Agree To Terms</label>
    </div>
    <br />
    <input type="submit" value="Sign Up" class="btn btn-primary w-100" />
    <div class="text-center mt-2">
        <a asp-action="Login">Already have an account?</a>
    </div>
</form>